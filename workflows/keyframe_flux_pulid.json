{
  "1": {
    "_meta": {
      "title": "Load FLUX.1-dev (open weights)"
    },
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "10": {
    "_meta": {
      "title": "Flux Guidance 3.5"
    },
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": [
        "9",
        0
      ],
      "guidance": 3.5
    }
  },
  "11": {
    "_meta": {
      "title": "Negative (empty for FLUX)"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": ""
    }
  },
  "12": {
    "_meta": {
      "title": "Landscape latent 1216x704 (shot frame)"
    },
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 704,
      "width": 1216
    }
  },
  "13": {
    "_meta": {
      "title": "Sample keyframe with identity locked"
    },
    "class_type": "KSampler",
    "inputs": {
      "cfg": 1.0,
      "denoise": 1.0,
      "latent_image": [
        "12",
        0
      ],
      "model": [
        "8",
        0
      ],
      "negative": [
        "11",
        0
      ],
      "positive": [
        "10",
        0
      ],
      "sampler_name": "euler",
      "scheduler": "simple",
      "seed": 777001,
      "steps": 20
    }
  },
  "14": {
    "_meta": {
      "title": "Decode"
    },
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "13",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "15": {
    "_meta": {
      "title": "Save keyframe"
    },
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "libertycut/keyframe",
      "images": [
        "14",
        0
      ]
    }
  },
  "2": {
    "_meta": {
      "title": "Dual CLIP (CLIP-L + T5-XXL fp8)"
    },
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
      "device": "default",
      "type": "flux"
    }
  },
  "3": {
    "_meta": {
      "title": "FLUX VAE"
    },
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "_meta": {
      "title": "PuLID-Flux weights"
    },
    "class_type": "PulidFluxModelLoader",
    "inputs": {
      "pulid_file": "pulid_flux_v0.9.1.safetensors"
    }
  },
  "5": {
    "_meta": {
      "title": "InsightFace (antelopev2) \u2014 set CPU on CPU-only runs"
    },
    "class_type": "PulidFluxInsightFaceLoader",
    "inputs": {
      "provider": "CUDA"
    }
  },
  "6": {
    "_meta": {
      "title": "EVA-CLIP (bundled with node pack)"
    },
    "class_type": "PulidFluxEvaClipLoader",
    "inputs": {}
  },
  "7": {
    "_meta": {
      "title": "Cast card reference (uploaded by app)"
    },
    "class_type": "LoadImage",
    "inputs": {
      "image": "libertycut_cast_ref.png"
    }
  },
  "8": {
    "_meta": {
      "title": "Lock cast identity into FLUX"
    },
    "class_type": "ApplyPulidFlux",
    "inputs": {
      "end_at": 1.0,
      "eva_clip": [
        "6",
        0
      ],
      "face_analysis": [
        "5",
        0
      ],
      "fusion": "mean",
      "image": [
        "7",
        0
      ],
      "model": [
        "1",
        0
      ],
      "pulid_flux": [
        "4",
        0
      ],
      "start_at": 0.0,
      "weight": 1.1
    }
  },
  "9": {
    "_meta": {
      "title": "Shot scene description (patched by app)"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "cinematic film still, the character stands at a night-market food stall strung with warm bulbs, steam rising from a grill, she turns and smiles at a friend off camera, teal and amber palette, anamorphic look, shallow depth of field"
    }
  }
}